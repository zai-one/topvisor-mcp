{
  "name": "topvisor",
  "version": "0.6.0",
  "description": "Topvisor rankings, AI tracker and guarded paid rank checks with agent skills",
  "author": {
    "name": "ZAI.ONE",
    "url": "https://github.com/zai-one"
  },
  "homepage": "https://github.com/zai-one/topvisor-mcp",
  "repository": "https://github.com/zai-one/topvisor-mcp",
  "license": "LicenseRef-ZAI-ONE",
  "skills": "./skills/",
  "mcpServers": {
    "topvisor": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/zai-one/topvisor-mcp@v0.6.0",
        "topvisor-mcp"
      ],
      "env": {
        "TOPVISOR_USER_ID": "${TOPVISOR_USER_ID}",
        "TOPVISOR_API_KEY_FILE": "${TOPVISOR_API_KEY_FILE}",
        "TOPVISOR_STATE_PATH": "${TOPVISOR_STATE_PATH}"
      }
    }
  }
}

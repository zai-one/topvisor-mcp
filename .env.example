# Example only. Export explicitly; the CLI does not load .env automatically.
TOPVISOR_USER_ID=1
TOPVISOR_API_KEY_FILE=/run/secrets/topvisor-api-key
TOPVISOR_STATE_PATH=/state/topvisor.sqlite
TOPVISOR_ACCOUNT_ID=default
TOPVISOR_LOCAL_PRINCIPAL=local-operator
TOPVISOR_WRITE_ENABLED=false
TOPVISOR_RATE_LIMIT=20
TOPVISOR_PRINCIPAL_RATE_LIMIT=20
TOPVISOR_MAX_CONCURRENCY=2

# Required for HTTP, with an RS256 JWT issuer matching these values.
TOPVISOR_MCP_PUBLIC_KEY_FILE=/run/secrets/topvisor-issuer-public.pem
TOPVISOR_MCP_ISSUER=topvisor-operator
TOPVISOR_MCP_AUDIENCE=topvisor-mcp
